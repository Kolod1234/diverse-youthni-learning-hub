{
  "name": "AudioNote",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string"
    },
    "audio_url": {
      "type": "string",
      "description": "Recorded audio file"
    },
    "duration_seconds": {
      "type": "number"
    },
    "transcript": {
      "type": "string",
      "description": "Auto-generated transcript"
    },
    "timestamp_position": {
      "type": "number",
      "description": "Where in lesson this was recorded"
    }
  },
  "required": [
    "lesson_id",
    "audio_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}