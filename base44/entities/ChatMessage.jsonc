{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Reference to ChatRoom"
    },
    "sender_email": {
      "type": "string",
      "description": "Sender email"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender display name"
    },
    "sender_avatar": {
      "type": "string",
      "description": "Sender avatar URL"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "system"
      ],
      "default": "text"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of the chat room's members, copied from ChatRoom when the message is sent. Used by the access rule."
    }
  },
  "required": [
    "room_id",
    "sender_email",
    "content"
  ]
}