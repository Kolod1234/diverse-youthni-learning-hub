{
  "name": "CourseEnrollment",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string",
      "description": "Reference to the course"
    },
    "user_email": {
      "type": "string",
      "description": "Email of enrolled user"
    },
    "user_name": {
      "type": "string",
      "description": "Name of enrolled user"
    },
    "assigned_by": {
      "type": "string",
      "description": "Email of coordinator/admin who assigned"
    },
    "coordinator_email": {
      "type": "string",
      "description": "Assigned coordinator for this enrollment"
    },
    "group_name": {
      "type": "string",
      "description": "Optional group/cohort name"
    },
    "enrollment_status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "dropped",
        "pending"
      ],
      "default": "active",
      "description": "Enrollment status"
    },
    "notes": {
      "type": "string",
      "description": "Coordinator notes"
    }
  },
  "required": [
    "course_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.coordinator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        },
        {
          "user_condition": {
            "data.is_coordinator": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.coordinator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    }
  }
}