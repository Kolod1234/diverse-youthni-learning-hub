{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Full event description"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM)"
    },
    "location": {
      "type": "string",
      "description": "Physical address or online link"
    },
    "is_online": {
      "type": "boolean",
      "default": false,
      "description": "Whether the event is online"
    },
    "online_link": {
      "type": "string",
      "description": "Meeting link for online events"
    },
    "image_url": {
      "type": "string",
      "description": "Banner image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "workshop",
        "webinar",
        "social",
        "competition",
        "training",
        "other"
      ],
      "default": "other",
      "description": "Event category"
    },
    "max_capacity": {
      "type": "number",
      "description": "Maximum number of attendees (0 = unlimited)"
    },
    "rsvp_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether RSVP is available"
    },
    "rsvp_deadline": {
      "type": "string",
      "format": "date",
      "description": "Last date to RSVP"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Whether the event is visible to users"
    }
  },
  "required": [
    "title",
    "date"
  ]
}