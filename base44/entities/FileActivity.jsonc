{
  "name": "FileActivity",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string",
      "description": "Reference to LibraryResource"
    },
    "action": {
      "type": "string",
      "enum": [
        "uploaded",
        "viewed",
        "downloaded",
        "shared",
        "commented",
        "updated"
      ],
      "description": "Type of activity"
    },
    "user_name": {
      "type": "string",
      "description": "User who performed action"
    },
    "details": {
      "type": "string",
      "description": "Additional details about the activity"
    }
  },
  "required": [
    "resource_id",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "create": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}