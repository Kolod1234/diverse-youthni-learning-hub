{
  "name": "FileComment",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string",
      "description": "Reference to LibraryResource"
    },
    "comment": {
      "type": "string",
      "description": "Comment text"
    },
    "user_name": {
      "type": "string",
      "description": "Commenter's name"
    },
    "user_avatar": {
      "type": "string",
      "description": "Commenter's avatar URL"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent comment ID for replies"
    }
  },
  "required": [
    "resource_id",
    "comment"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}