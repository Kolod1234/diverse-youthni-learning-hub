{
  "name": "GroupStudySession",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "Study group reference"
    },
    "title": {
      "type": "string",
      "description": "Session title"
    },
    "description": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60
    },
    "challenge_id": {
      "type": "string",
      "description": "Optional challenge for the session"
    },
    "organizer_email": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "joined",
              "maybe",
              "declined"
            ]
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "Event ID on the shared organiser calendar"
    },
    "calendar_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "calendar_sync_error": {
      "type": "string"
    },
    "email_reminder_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "email_reminder_sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "group_id",
    "title",
    "scheduled_time"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": {
      "$or": [
        {
          "data.organizer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organizer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}