{
  "name": "KahootGame",
  "type": "object",
  "properties": {
    "pin": {
      "type": "string",
      "description": "6-digit game PIN"
    },
    "title": {
      "type": "string",
      "description": "Game title"
    },
    "category": {
      "type": "string",
      "description": "Game subject or category"
    },
    "tags": {
      "type": "array",
      "description": "Optional tags for easier searching",
      "items": {
        "type": "string"
      }
    },
    "host_email": {
      "type": "string",
      "description": "Email of the tutor hosting the game"
    },
    "status": {
      "type": "string",
      "enum": [
        "lobby",
        "question",
        "results",
        "leaderboard",
        "finished"
      ],
      "default": "lobby",
      "description": "Current game state"
    },
    "current_question_index": {
      "type": "number",
      "default": 0,
      "description": "Index of the current question being shown"
    },
    "question_started_at": {
      "type": "string",
      "description": "ISO timestamp when current question started"
    },
    "questions": {
      "type": "array",
      "description": "List of questions for this game",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "question_type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "image_based",
              "true_false",
              "fill_in_gap",
              "identification_autism",
              "short_answer",
              "long_answer"
            ],
            "default": "multiple_choice"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "number"
          },
          "correct_text_answer": {
            "type": "string"
          },
          "accepted_answers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "time_limit_seconds": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          },
          "visual_description": {
            "type": "string"
          },
          "prompt_label": {
            "type": "string"
          },
          "video_url": {
            "type": "string"
          }
        }
      }
    },
    "participants": {
      "type": "array",
      "description": "List of joined players",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "Public username displayed on live scoreboards"
          },
          "email": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "coins": {
            "type": "number"
          },
          "power_ups": {
            "type": "object",
            "properties": {
              "double_points": {
                "type": "number"
              },
              "shield": {
                "type": "number"
              },
              "skip_question": {
                "type": "number"
              },
              "fifty_fifty": {
                "type": "number"
              },
              "freeze_opponents": {
                "type": "number"
              },
              "reveal_answer": {
                "type": "number"
              },
              "steal_points": {
                "type": "number"
              }
            }
          },
          "active_power_up": {
            "type": "string"
          },
          "power_up_effects": {
            "type": "object",
            "properties": {
              "frozen_until_question": {
                "type": "number"
              },
              "reveal_answer_for_question": {
                "type": "number"
              }
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_index": {
                  "type": "number"
                },
                "selected_answer": {
                  "type": "number"
                },
                "text_answer": {
                  "type": "string"
                },
                "is_correct": {
                  "type": "boolean"
                },
                "time_taken_ms": {
                  "type": "number"
                },
                "points_earned": {
                  "type": "number"
                },
                "used_power_up": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "pin",
    "title",
    "host_email"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}