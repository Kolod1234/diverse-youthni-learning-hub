{
  "name": "Logbook",
  "type": "object",
  "properties": {
    "program_id": {
      "type": "string",
      "description": "Reference to program"
    },
    "participant_email": {
      "type": "string",
      "description": "Participant's email"
    },
    "participant_name": {
      "type": "string",
      "description": "Participant's name"
    },
    "participant_avatar": {
      "type": "string",
      "description": "Participant's profile picture URL"
    },
    "participant_role": {
      "type": "string",
      "description": "Participant's role in the program"
    },
    "week_number": {
      "type": "number",
      "description": "Week number of the program"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "duty_for_week": {
      "type": "string",
      "description": "Assigned duty/role for this week"
    },
    "days_of_work": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Days worked this week (e.g., Monday, Tuesday)"
    },
    "hours_per_week": {
      "type": "number",
      "description": "Total hours spent this week"
    },
    "activity_summary": {
      "type": "string",
      "description": "Summary of activities completed"
    },
    "skills_developed": {
      "type": "string",
      "description": "Skills learned or practiced"
    },
    "challenges": {
      "type": "string",
      "description": "Challenges faced"
    },
    "coordinator_comment": {
      "type": "string",
      "description": "Feedback from coordinator"
    },
    "upcoming_task": {
      "type": "string",
      "description": "Next week's task or goal"
    },
    "recommendation_for_improvement": {
      "type": "string",
      "description": "Recommendations for participant improvement"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Has coordinator approved this entry"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of coordinator who approved"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "program_id",
    "participant_email",
    "entry_date",
    "activity_summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_coordinator": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.participant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_coordinator": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.participant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_coordinator": true
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}