{
  "name": "ParentChildLink",
  "type": "object",
  "properties": {
    "parent_user_id": {
      "type": "string"
    },
    "parent_email": {
      "type": "string",
      "format": "email"
    },
    "child_user_id": {
      "type": "string"
    },
    "child_email": {
      "type": "string",
      "format": "email"
    },
    "child_name": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "link_method": {
      "type": "string",
      "enum": [
        "invited",
        "existing"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "verification_note": {
      "type": "string"
    },
    "processed_by": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "parent_user_id",
    "parent_email",
    "child_email",
    "child_name",
    "link_method",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.parent_user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}