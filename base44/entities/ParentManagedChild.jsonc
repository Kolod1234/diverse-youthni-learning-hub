{
  "name": "ParentManagedChild",
  "type": "object",
  "properties": {
    "parent_user_id": {
      "type": "string"
    },
    "parent_email": {
      "type": "string",
      "format": "email"
    },
    "child_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "parent_user_id",
    "parent_email",
    "child_name",
    "date_of_birth"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.parent_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}