{
  "name": "ParentProfile",
  "type": "object",
  "properties": {
    "parent_user_id": {
      "type": "string"
    },
    "parent_email": {
      "type": "string",
      "format": "email"
    },
    "parent_name": {
      "type": "string"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "parent_user_id",
    "parent_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.parent_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}