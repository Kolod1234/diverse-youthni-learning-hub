{
  "name": "PathwayResource",
  "type": "object",
  "properties": {
    "pathway_id": {
      "type": "string",
      "description": "Reference to LearningPathway"
    },
    "resource_id": {
      "type": "string",
      "description": "Reference to LibraryResource"
    },
    "order": {
      "type": "number",
      "description": "Order in the pathway"
    },
    "is_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether this resource is required for completion"
    },
    "notes": {
      "type": "string",
      "description": "Educator's notes for this resource"
    }
  },
  "required": [
    "pathway_id",
    "resource_id",
    "order"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}