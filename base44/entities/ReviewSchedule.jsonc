{
  "name": "ReviewSchedule",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "interval_days": {
      "type": "number",
      "default": 1,
      "description": "Current spaced repetition interval"
    },
    "mastery_level": {
      "type": "number",
      "default": 0,
      "description": "0-100 mastery score"
    }
  },
  "required": [
    "lesson_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "create": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}