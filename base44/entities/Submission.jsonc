{
  "name": "Submission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "description": "Reference to assignment"
    },
    "student_email": {
      "type": "string",
      "description": "Student's email"
    },
    "student_name": {
      "type": "string",
      "description": "Student's name"
    },
    "content": {
      "type": "string",
      "description": "Submission text"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Attached files"
    },
    "grade": {
      "type": "number",
      "description": "Points awarded"
    },
    "feedback": {
      "type": "string",
      "description": "Instructor feedback"
    },
    "is_graded": {
      "type": "boolean",
      "default": false
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "assignment_id",
    "student_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_tutor": true
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}