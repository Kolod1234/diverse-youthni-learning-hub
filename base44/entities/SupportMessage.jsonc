{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string",
      "description": "Reference to SupportChat"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "bot"
      ],
      "default": "user",
      "description": "Who sent this message"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "content": {
      "type": "string",
      "description": "Message text"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns the support chat, copied from SupportChat. Used by the access rule."
    }
  },
  "required": [
    "chat_id",
    "content",
    "sender_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}