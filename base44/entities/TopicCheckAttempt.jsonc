{
  "name": "TopicCheckAttempt",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "set_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "submitted"
      ]
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "score": {
      "type": "number"
    },
    "total": {
      "type": "integer"
    },
    "percentage": {
      "type": "number"
    },
    "passed": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "feedback": {
      "type": "object"
    }
  },
  "required": [
    "user_id",
    "lesson_id",
    "course_id",
    "set_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}