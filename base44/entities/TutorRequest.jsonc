{
  "name": "TutorRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user requesting tutor status"
    },
    "user_name": {
      "type": "string",
      "description": "Name of user"
    },
    "reason": {
      "type": "string",
      "description": "Why they want to be a tutor"
    },
    "qualifications": {
      "type": "string",
      "description": "Teaching qualifications or experience"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Subjects they want to teach"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "processed_by": {
      "type": "string",
      "description": "Admin who processed the request"
    },
    "processed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was processed"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}