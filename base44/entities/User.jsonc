{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "Unique public username shown instead of the user's real name"
    },
    "username_normalized": {
      "type": "string",
      "description": "Lowercase username used for uniqueness checks"
    },
    "username_set_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_inactivity_email_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last inactivity re-engagement email sent to this user"
    },
    "disable_inactivity_emails": {
      "type": "boolean",
      "default": false,
      "description": "If true, this user will not receive inactivity re-engagement emails"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "learner",
        "parent"
      ],
      "description": "Optional portal type selected by the user"
    },
    "account_banned": {
      "type": "boolean",
      "default": false,
      "description": "Administrative account restriction"
    },
    "ban_reason": {
      "type": "string",
      "description": "Reason shown to the restricted user"
    },
    "banned_at": {
      "type": "string",
      "format": "date-time"
    },
    "tutor_compliance_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "tutor_compliance_last_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "tutor_compliance_notice_for_due": {
      "type": "string",
      "format": "date-time"
    },
    "course_access_granted": {
      "type": "boolean",
      "default": false,
      "description": "Set by the verifyAccessCode function when the course access code is accepted."
    },
    "coordinator_access_granted": {
      "type": "boolean",
      "default": false,
      "description": "Set by the verifyAccessCode function when the coordinator access code is accepted."
    },
    "deletion_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set by deleteMyAccount when the user deletes their account."
    }
  }
}