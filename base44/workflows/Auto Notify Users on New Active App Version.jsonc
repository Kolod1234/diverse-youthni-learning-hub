{
  "name": "Auto Notify Users on New Active App Version",
  "description": "When an AppVersion record is created or updated with notify_users=true and is_active=true, automatically email all users.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "AppVersion"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_notify_users_on_new_active_app_version",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoNotifyAppUpdate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoNotifyAppUpdate"
  }
}